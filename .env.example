# Claude API 키 (필수, 실제 AI 작업용)
ANTHROPIC_API_KEY=

# 관리자 로그인 비밀번호 (비우면 인증 없음 — 외부 공개 서버에서는 반드시 설정)
MABU_ADMIN_PASSWORD=

# claude | mock(테스트용 가짜 AI)
MABU_AGENT=claude
MABU_MODEL=claude-sonnet-5-5
MABU_MAX_TURNS=30
MABU_MAX_BUDGET_USD=1
MABU_RESUME=0
MABU_RESTRICT=1

# 요청 자동 분류: 질문·간단한 수정은 저렴한 모델로 처리
MABU_AUTO_ROUTE=1
MABU_FAST_MODEL=claude-haiku-5-5

# 개발자 호출: 노션 기록 (선택) — 데이터베이스 링크나 ID. 통합을 데이터베이스에 연결해 두어야 한다
# 토큰이 있으면 채팅에 붙여 넣은 노션 링크도 읽는다 (읽을 페이지나 표마다 통합 연결 필요)
MABU_NOTION_TOKEN=
MABU_NOTION_DATABASE=

# 개발자 호출: 이메일 (선택) — Gmail은 2단계 인증 후 만든 앱 비밀번호
MABU_SMTP_HOST=smtp.gmail.com
MABU_SMTP_PORT=587
MABU_SMTP_USER=
MABU_SMTP_PASSWORD=
MABU_MAIL_FROM=
# 받을 개발자 (쉼표로 여러 명)
MABU_MAIL_TO=

# 호출·배포 알림 웹훅 (Slack/Discord 호환, 선택)
MABU_NOTIFY_WEBHOOK=

MABU_DATA_DIR=./data
MABU_WORKSPACES=./data/workspaces
